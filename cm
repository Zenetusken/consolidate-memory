#!/usr/bin/env bash
# cm — dev entry point for the consolidate-memory tool. Thin dispatcher over the
# plugin's scripts (plugins/consolidate-memory/scripts/) so a maintainer can drive a
# pass (or inspect the network) from the shell without the plugin being installed.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # readlink -f → resolve a PATH symlink to the real repo (so `cm` works installed on PATH)
S="$HERE/plugins/consolidate-memory/scripts"
cmd="${1:-help}"; shift || true

case "$cmd" in
  status)   exec python3 "$S/memory_status.py" "$@" ;;            # Phase 0 context
  seed)     exec python3 "$S/memory_status.py" --json "$@" ;;     # cycle-record seed
  extract)  exec python3 "$S/extract_signals.py" "$@" ;;          # Phase 2 session signal
  distill)  exec python3 "$S/distill_scan.py" "$@" ;;             # Phase-5 distill: recurring workflow templates
  sync)     exec python3 "$S/sync_global.py" "$@" ;;              # --list/--pull PROJECT_DIR
  pull)     exec python3 "$S/sync_global.py" --pull "${1:-.}" ;;  # replicate globals here
  gc)       exec python3 "$S/sync_global.py" --gc "$@" ;;         # reclaim orphan mirrors (+ --apply)
  promote)  exec python3 "$S/sync_global.py" --promote "$@" ;;    # DIR LOCAL_FACT [CANON]: local→canonical hand-off
  tokens)   exec python3 "$S/sync_global.py" --tokens "$@" ;;     # network token consumption (+ --json)
  utility)  exec python3 "$S/sync_global.py" --utility "$@" ;;    # fleet usage evidence + fleet tax (+ --json)
  harvest)  exec python3 "$S/sync_global.py" --harvest "$@" ;;    # capture every node's usage windows into the fleet ledger
  staleness) exec python3 "$S/sync_global.py" --staleness "$@" ;; # absorption lag per node (read-only; beacon Stage A)
  workflows) exec python3 "$S/sync_global.py" --workflows "$@" ;; # fleet workflow evidence over the W-A distill rows (read-only)
  calibration) exec python3 "$S/calibration_report.py" "$@" ;; # the standing fleet-calibration report + baseline delta (read-only; the refit stays gated)
  beacon)   cd "${1:-$PWD}" 2>/dev/null && exec python3 "$S/session_beacon.py" </dev/null ;; # dump the session-beacon line for DIR (debug)
  network)  exec python3 "$S/sync_global.py" --network "${1:-.}" ;;         # shared-consciousness graph
  render)   exec python3 "$S/render_dashboard.py" "$@" ;;         # cycle.json -> ASCII dashboard
  report)   if [ -d "${1:-}" ]; then exec python3 "$S/render_html.py" --project "$1"; elif echo "${1:-}" | grep -qE '^[0-9a-f]{4,40}$'; then exec python3 "$S/render_html.py" --select "$1" --project "${2:-.}"; else exec python3 "$S/render_html.py" --project "${1:-.}"; fi ;;  # existing dir → its archive · hex → a dream by hash · else cwd archive
  log)      if [ -d "${1:-}" ]; then D="$1"; shift; else D="."; fi; exec python3 "$S/render_log.py" --project "$D" "$@" ;;  # lean per-dream audit table ([-n N] / --json pass through)
  doctor)   exec python3 "$S/cm_ops.py" doctor "$@" ;;
  conflicts) exec python3 "$S/cm_ops.py" conflicts "$@" ;;
  resolve)  exec python3 "$S/cm_ops.py" resolve "$@" ;;
  repair-mirror) exec python3 "$S/cm_ops.py" repair-mirror "$@" ;;
  canonical) exec python3 "$S/cm_ops.py" canonical "$@" ;;
  local)    exec python3 "$S/cm_ops.py" local "$@" ;;
  marker)   exec python3 "$S/cm_ops.py" marker "$@" ;;
  justify-demotion) exec python3 "$S/memory_status.py" --justify-demotion "$@" ;;
  migrate)  exec python3 "$S/cm_ops.py" migrate "$@" ;;
  data)     exec python3 "$S/cm_ops.py" data "$@" ;;
  project)  exec python3 "$S/cm_ops.py" project "$@" ;;
  journal)  exec python3 "$S/cm_ops.py" journal "$@" ;;
  forget)   exec python3 "$S/cm_ops.py" canonical forget "$@" ;;
  help|*)
    cat <<'EOF'
cm — consolidate-memory (MAINTAINER CLI for this checkout; marketplace
users run the skill — they do not have ./cm on PATH)

  Unenrolled projects are local-only. cm doctor prints UNENROLLED LOCAL-ONLY.
  Enroll with `cm project enroll --domain NAME --apply --confirm enroll-<domain>`.
  Marketplace users: /cm-domain. Canonicals live under domains/<domain>/facts,
  not ~/.claude/memory.

  cm status [DIR]      Phase-0 context (stores, git range, marker)
  cm extract [--json]  curated session signal (human turns + error gotchas); --recalls [--into SEED]
                       [--before SNAPSHOT] tracks organic fact-body reads this window (Phase A usage
                       telemetry, script-only; v0.1.67 adds archive-tier MISS detection — tier judged
                       against the Phase-0 snapshot — and strikes just-read stems from demotion.surfaced)
  cm distill [DIR]     recurring Bash-command workflow templates + chains (the distill phase's scan;
                       [--since ISO] [--json]; --into SEED injects the counts into a cycle record,
                       --from SCAN.json injects a saved scan without re-scanning)
  cm sync --list DIR   show which global facts apply to a project
  cm pull [DIR]        replicate relevant global facts into a project (default: .); M1 holds a pull
                       only past the HARD CEILING (~3840t, v0.1.66) — an over-target store receives
                       verified knowledge freely (the amber band); past the ceiling only shrinking
                       satisfies (--evict=<fact> to free one pointer, or --allow-net-grow)
  cm gc [DIR] [--edges] [--apply] reclaim orphaned mirrors; --edges = fleet-wide ghost provenance-edge triage (report-only without --apply)
  cm promote DIR FACT [CANON]  hand a local fact up to the global store + mirror the origin
  cm tokens [DIR] [--json] per-node + total token consumption across the network
  cm utility [DIR] [--json] fleet usage evidence per canonical (mirror-attributed reads, fleet tax vs
                       the warn-only advisory) — the gc lever's evidence table (v0.1.67, Phase C)
  cm harvest [DIR]        capture every node's organic-read windows into plugin-data fleet-usage.jsonl
                       (never the canonical Markdown plane; leftover ~/.claude/memory/.fleet-usage.jsonl is read-only)
  cm staleness [DIR] [--json] absorption lag per node — last dream, missing globals, stale mirrors (read-only)
  cm workflows [DIR] [--json] [--registrar] [--into SEED] fleet-recurring workflow templates/chains + adoption + verdict
                       lineage (read-only); --registrar adds the Tier-2 mechanical gate cascade
                       (fleet-candidates vs blocked, decline anchors); --into injects that evidence
                       into the cycle seed — proposals stay report-then-apply
  cm calibration [--json]  the standing fleet-calibration report: magnitude/band distribution, index
                       utilization, usage/miss signal, demotion windows + the DELTA vs the frozen
                       2026-08-29 baseline — one command decides whether the band/budget refit
                       evidence gate has accrued data (read-only; the refit itself stays gated)
  cm beacon [DIR]         print the SessionStart beacon line for DIR (empty = silent; debug lens)
  cm network [DIR]     current-domain shared-memory graph (`--all-domains` is admin)
  cm render cycle.json render an ASCII dashboard from a cycle record
  cm report [DIR]      [maintainer dev CLI] open DIR's dream archive (DEFAULT: THIS repo — pass another
                       repo's path to view it, e.g. cm report ~/project/job-applicator-python).
                       End users just open ~/.claude/projects/<slug>/dashboards/index.html directly.
  cm report HASH [DIR] re-open a specific dream's dashboard by its commit-hash prefix
  cm log [DIR] [-n N]  dense per-dream audit TABLE over DIR's .consolidation-log.jsonl (DEFAULT: THIS repo);
                       add --json for the raw cycle records (pipe to jq). The 3rd view of the dream log.
  cm doctor [DIR]      resolved Claude store, source, profile, domain, auto-memory, ambiguity
  cm conflicts [DIR]   three-way mirror conflict queue
  cm resolve FACT      --keep-canonical | --fork-local NAME | --promote-local
  cm repair-mirror FACT
  cm canonical upsert STEM [--file PATH] [--origin]
  cm canonical catalog the domain's catalog (facts manifest: stems × classes × secret flags)
  cm canonical forget|supersede|expire|reactivate STEM
  cm canonical resurrect STEM --file PATH   replace a tombstone stub with a new body
  cm local upsert|update|archive|forget STEM [--file PATH]
  cm local rebuild-index [--plan|--apply --confirm rebuild-local-index] [--skip-invalid]
  cm local migrate-schema [--apply --confirm migrate-local-schema]
  cm marker stamp --commit SHA [--timestamp ISO]
  cm marker standing-justify --facts N [--index-tokens N]
  cm marker snooze --until ISO
  cm justify-demotion STEM [STEM…] [--force]  stamp demotion_justify at the monotonic usage-window sequence (candidate-gated; --force for repair)
  cm migrate [--plan|--assign STEM --domain NAME|--exclude STEM|--apply|--rollback|--finalize|--status]
                       (--apply --confirm migrate-apply · --rollback --confirm migrate-rollback)
  cm data inventory|compact|export|import|purge|purge-status|purge-resume|purge-cancel|retention
                       import --file ARCHIVE [--apply --confirm data-import]
                       purge --scope domain-canonicals|all-plugin-data
                       [--apply --confirm purge-domain-canonicals|purge-all-plugin-data]
                       purge-status|resume|cancel --domain NAME
                       cancel --accept-partial when canonicals already gone
  cm journal inventory|show|retry|rollback|abandon|compact|cleanup [OP-ID]
                       cleanup [--scan-all-stores] [--apply --confirm journal-cleanup]
                       abandon --accept-fs after verifying leftover trash/recovery
  cm forget STEM       tombstone a canonical (does not resurrect on pull)
  cm project enroll --domain NAME [DIR] [--apply --confirm enroll-<domain>]
  cm project grants [DIR]                    list the operator's granted stores
  cm project grant-native --path PATH [DIR]  operator grant for a dedicated native store
  cm project revoke-native --path PATH [DIR] revoke a dedicated native store
  cm project transfer-native --path PATH [DIR]  transfer native-store ownership
  cm project move-domain --to NAME [DIR]
  cm project rebind [DIR]
  cm project show [DIR]
  cm project unenroll [DIR]

A full pass is best driven by the plugin itself. Dogfood it from this repo:
  claude plugin marketplace add ./
  claude plugin install consolidate-memory@zenetusken-plugins
then say "dream" in any project. See README.md.
EOF
    ;;
esac
